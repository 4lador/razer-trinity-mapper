<services>
  <service name="obs_scm">
    <param name="url">https://github.com/4lador/razer-trinity-mapper.git</param>
    <param name="scm">git</param>
    <param name="revision">v0.2.2</param>
    <param name="versionformat">0.2.2</param>
    <param name="filename">razer-trinity-mapper</param>
  </service>
  <service name="cargo_vendor">
    <param name="src">razer-trinity-mapper-0.2.2.tar.gz</param>
  </service>
  <service name="recompress">
    <param name="file">*.tar.gz</param>
    <param name="compression">gz</param>
  </service>
  <service name="set_version" />
</services>
